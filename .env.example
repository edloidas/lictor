# Copy to `.env`. Bun loads it automatically — `.env` is gitignored.

# Port the server binds. Optional, defaults to 3000.
PORT=3000

# GitHub App → Settings → the numeric "App ID" field.
GITHUB_APP_ID=

# The webhook secret you set on the App. Generate one with:
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Contents of the .pem you downloaded from the App's "Private keys" section.
# Either paste it as one line with \n between the PEM lines, or wrap the whole
# multi-line value in double quotes.
GITHUB_PRIVATE_KEY=
