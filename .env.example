# Copy to `.env`. Bun loads it automatically — `.env` is gitignored.

# Port the server binds. Optional, defaults to 3000.
PORT=3000

# Classic personal access token for the account the daemon acts as, with the
# `repo` scope. Deliberately not `GITHUB_TOKEN`: `gh`, GitHub Actions, and
# direnv all export that name, and Bun will not let `.env` override a variable
# the shell already exported — a stray export would silently run the daemon as
# whoever owns that token.
LICTOR_GITHUB_TOKEN=

# Login the token must belong to. Asserted against `GET /user` at startup, so a
# swapped or revoked token fails loudly instead of acting as the wrong account.
LICTOR_GITHUB_LOGIN=

# Comma-separated GitHub logins whose activity may create work. Empty trusts
# nobody. The daemon's own login must not appear here — startup refuses it. Who
# she answers *to* is this list; who she answers *as* is LICTOR_GITHUB_LOGIN.
GITHUB_TRUSTED_SENDERS=

# Daemon state. These are the defaults — leave them unset unless you want the
# state somewhere else. Parent directories are created on startup, and a leading
# `~/` is expanded. `CODEX_HOME` follows the database directory, so the agent's
# home is `~/.lictor/codex` by default.
# LICTOR_DATABASE_PATH=~/.lictor/lictor.sqlite
# LICTOR_POLICY_PATH=~/.lictor/policy.toml
# LICTOR_SOCKET_PATH=~/.lictor/lictor.sock

# Explicit CODEX_HOME for the executor. Unset, the agent's home stays `codex/`
# beside the database (`~/.lictor/codex` by default). Point it at `~/.codex` to
# share login and config with your interactive codex — at the cost of isolation:
# your config then shapes the agent and it can read your session history.
# LICTOR_CODEX_HOME=~/.lictor/codex
# Largest delivery body the poller may hand the queue, in bytes.
LICTOR_DELIVERY_MAX_BYTES=1048576

# Local agent execution. Set `disabled` to retain work without running it.
# ! The code default is `codex`, so deleting this line enables execution.
LICTOR_EXECUTOR=disabled
LICTOR_CODEX_MODEL=gpt-5.6-luna
LICTOR_AGENT_WORKDIR=.
LICTOR_EXECUTOR_TIMEOUT_MS=1800000
# Ceiling on every git operation the service runs, network and local alike
# (clone, fetch, and the working-tree checkout). Raising it to fit a slow clone
# also raises the budget of a wedged filesystem for local operations.
LICTOR_GIT_TIMEOUT_MS=180000
LICTOR_EXECUTOR_OUTPUT_BYTES=262144
LICTOR_WORKER_POLL_MS=1000
LICTOR_WORKER_MAX_ATTEMPTS=3
LICTOR_WORKER_RETRY_BASE_MS=30000

# Floor for the gap between notification polls. GitHub returns `X-Poll-Interval`
# and this only stops an absent or implausibly small value from spinning the loop.
LICTOR_NOTIFICATION_POLL_MS=60000

# Comma-separated GitHub logins whose repository invitations are accepted
# automatically, on the polling cadence. Empty accepts nothing. Nobody is ever
# declined — untrusted invitations stay pending, and a pending invitation is
# the signal that somebody is trying to add her somewhere. Joining a repository
# arms nothing: no policy entry exists for it until you write one.
LICTOR_AUTO_ACCEPT_INVITERS=
