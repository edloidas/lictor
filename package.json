{
  "name": "lictor",
  "private": true,
  "version": "0.1.0",
  "description": "A lictor for your agent: watches GitHub, hands work.",
  "keywords": ["lictor", "github", "notifications", "bot", "effect", "bun"],
  "homepage": "https://github.com/edloidas/lictor",
  "bugs": {
    "url": "https://github.com/edloidas/lictor/issues",
    "email": "edloidas@gmail.com"
  },
  "license": "MIT",
  "author": "Mikita Taukachou <edloidas@gmail.com> (https://edloidas.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edloidas/lictor.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || exit 0",
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "cli": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run typecheck && biome check .",
    "check:fix": "bun run typecheck && biome check --write .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:ci": "bun test --bail --coverage",
    "validate": "bun run check && bun run test:ci"
  },
  "nano-staged": {
    "*.{ts,tsx}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@effect/platform": "^0.97.1",
    "@effect/platform-bun": "^0.91.2",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "nano-staged": "^1.0.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
